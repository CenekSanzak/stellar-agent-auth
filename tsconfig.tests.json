{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@stellar-agent-auth/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@stellar-agent-auth/sdk/node": [
        "./packages/sdk/src/node.ts"
      ],
      "@stellar-agent-auth/verifier": [
        "./services/verifier/src/index.ts"
      ],
      "@stellar-agent-auth/submitter": [
        "./services/submitter/src/index.ts"
      ],
      "@stellar-agent-auth/cli": [
        "./packages/cli/src/index.ts"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "packages/**/*.ts",
    "services/**/*.ts",
    "deployments/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
