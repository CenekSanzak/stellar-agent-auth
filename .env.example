# Non-secret configuration. No addresses exist until deployment.
STELLAR_NETWORK=local
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
STELLAR_RPC_URL=http://localhost:8000/rpc
# Optional SHA-256 of the network passphrase; validated when supplied.
STELLAR_NETWORK_ID=
AGENT_REGISTRY_ID=
VERIFICATION_REGISTRY_ID=
WALLET_ID=
VERIFIER_PUBLIC_ADDRESS=
# Path to a file holding the verifier secret key, readable by its owner only. Never put the key itself here.
VERIFIER_SECRET_KEY_FILE=
VERIFIER_STATE_DIR=.local/verifier
TEST_ASSET_CONTRACT_ID=
INDEXER_DATABASE_PATH=.local/history.sqlite
DEPLOYMENT_EPOCH=local-p0
