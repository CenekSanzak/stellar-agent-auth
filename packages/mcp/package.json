  },
  "bin": {
    "stellar-agent-auth-mcp": "./dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stellar-agent-auth/sdk": "0.0.0",
    "@stellar-agent-auth/x402": "0.0.0",
    "@stellar/stellar-sdk": "17.4.0",
    "zod": "4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
