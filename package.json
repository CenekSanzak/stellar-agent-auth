{
  "name": "stellar-agent-auth",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json --noEmit",
    "check:rust": "cargo check --workspace --locked",
    "format:rust:check": "cargo fmt --all -- --check",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project local",
    "test:testnet": "node scripts/testnet.mjs",
    "test:rust": "node scripts/rust-tests.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "build:contracts": "node scripts/build-contracts.mjs",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:ready": "node scripts/local-ready.mjs",
    "dev": "npm run local:up && npm run local:ready",
    "check": "npm run typecheck && npm run build && npm run test:unit && npm run check:rust && npm run format:rust:check && npm run lint:rust && npm run test:rust && npm run build:contracts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1"
}
